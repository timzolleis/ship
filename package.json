{
  "name": "ship",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "vitest run",
    "build": "bun build src/main.ts --compile --minify --sourcemap --bytecode --define SHIP_VERSION_CONST=\"\\\"$(git rev-parse --short HEAD)\\\"\" --outfile ship",
    "install-bin": "cp ./ship ~/.local/bin/ship && codesign --sign - --force ~/.local/bin/ship",
    "typecheck": "tsc --noEmit && effect-language-service diagnostics --project tsconfig.json --format pretty"
  },
  "dependencies": {
    "@effect/cli": "latest",
    "@effect/platform": "latest",
    "@effect/platform-bun": "latest",
    "@effect/platform-node": "latest",
    "effect": "latest"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@effect/vitest": "^0.29.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
